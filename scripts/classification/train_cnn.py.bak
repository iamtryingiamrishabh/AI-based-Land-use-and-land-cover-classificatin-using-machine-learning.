"""Train and evaluate the LULC CNN using labelled image patches."""

import copy
import random

import numpy as np
import torch
import torch.nn as nn

from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
    f1_score,
)

from lulc_common import (
    OUTPUT_DIR,
    PATCH_FILE,
    MODEL_FILE,
    CLASS_NAMES,
    FEATURE_NAMES,
    block_split,
)


# --------------------------- CONFIGURATION ---------------------------

SEED = 42
EPOCHS = 25
BATCH_SIZE = 64
LEARNING_RATE = 0.001
WEIGHT_DECAY = 0.0001
PATIENCE = 6

STATS_SAMPLE_PATCHES = 1000
PREDICT_BATCH_SIZE = 128

PATCH_SIZE = 32
INPUT_CHANNELS = 6

# Geographic split search: try seeds until every class has at least
# MIN_SPLIT_PER_CLASS patches in both validation and test.
SPLIT_SEED_START = 42
SPLIT_SEED_TRIES = 300
MIN_SPLIT_PER_CLASS = 30

USE_CLASS_WEIGHTS = True

# --------------------------------------------------------------------


class SmallCNN(nn.Module):
    """Small CNN for six-channel 32x32 satellite image patches."""

    def __init__(self, in_channels=INPUT_CHANNELS, n_classes=len(CLASS_NAMES)):
        super().__init__()

        def conv_block(in_ch, out_ch):
            return nn.Sequential(
                nn.Conv2d(in_ch, out_ch, kernel_size=3, padding=1, bias=False),
                nn.BatchNorm2d(out_ch),
                nn.ReLU(inplace=True),
                nn.Conv2d(out_ch, out_ch, kernel_size=3, padding=1, bias=False),
                nn.BatchNorm2d(out_ch),
                nn.ReLU(inplace=True),
                nn.MaxPool2d(kernel_size=2),
            )

        self.features = nn.Sequential(
            conv_block(in_channels, 16),
            conv_block(16, 32),
            conv_block(32, 64),
        )

        self.classifier = nn.Sequential(
            nn.AdaptiveAvgPool2d(1),
            nn.Flatten(),
            nn.Dropout(0.30),
            nn.Linear(64, n_classes),
        )

    def forward(self, x):
        return self.classifier(self.features(x))


def augment(batch):
    """Per-sample random flips and transpose (all 8 dihedral variants).

    The same transform is applied to every channel of a sample.
    """
    n = batch.shape[0]
    dev = batch.device

    flip_w = (torch.rand(n, device=dev) < 0.5).view(-1, 1, 1, 1)
    batch = torch.where(flip_w, torch.flip(batch, dims=(3,)), batch)

    flip_h = (torch.rand(n, device=dev) < 0.5).view(-1, 1, 1, 1)
    batch = torch.where(flip_h, torch.flip(batch, dims=(2,)), batch)

    swap = (torch.rand(n, device=dev) < 0.5).view(-1, 1, 1, 1)
    batch = torch.where(swap, batch.transpose(2, 3), batch)

    return batch.contiguous()


def get_normalisation_stats(X, train_mask):
    """Mean and standard deviation from training patches only."""
    indices = np.flatnonzero(train_mask)

    if len(indices) == 0:
        raise ValueError("No training patches available.")

    rng = np.random.default_rng(SEED)

    if len(indices) > STATS_SAMPLE_PATCHES:
        indices = rng.choice(indices, STATS_SAMPLE_PATCHES, replace=False)

    # h5/npz fancy indexing needs sorted indices for some backends
    indices = np.sort(indices)
    sample = np.asarray(X[indices], dtype=np.float32)

    mean = sample.mean(axis=(0, 2, 3), keepdims=True)
    std = np.maximum(sample.std(axis=(0, 2, 3), keepdims=True), 1e-6)

    return (
        torch.tensor(mean, dtype=torch.float32),
        torch.tensor(std, dtype=torch.float32),
    )


def make_batch(X, indices, mean, std, device):
    """Convert only the current batch to float32 and normalise it."""
    batch = torch.from_numpy(np.asarray(X[indices], dtype=np.float32))
    batch = (batch - mean) / std
    return batch.to(device)


def predict(model, X, indices, mean, std, device):
    model.eval()
    predictions = []

    with torch.no_grad():
        for start in range(0, len(indices), PREDICT_BATCH_SIZE):
            batch_indices = indices[start:start + PREDICT_BATCH_SIZE]
            xb = make_batch(X, batch_indices, mean, std, device)
            logits = model(xb)
            predictions.extend(logits.argmax(dim=1).cpu().numpy().tolist())

    return np.asarray(predictions, dtype=np.int64)


def evaluate(model, X, y, indices, mean, std, device, criterion):
    """Loss and macro F1 (over classes present in the split)."""
    model.eval()

    all_predictions = []
    total_loss = 0.0
    total_count = 0

    with torch.no_grad():
        for start in range(0, len(indices), PREDICT_BATCH_SIZE):
            batch_indices = indices[start:start + PREDICT_BATCH_SIZE]

            xb = make_batch(X, batch_indices, mean, std, device)
            targets = torch.tensor(y[batch_indices], dtype=torch.long,
                                   device=device)

            logits = model(xb)
            loss = criterion(logits, targets)

            count = len(batch_indices)
            total_loss += loss.item() * count
            total_count += count

            all_predictions.extend(logits.argmax(dim=1).cpu().numpy().tolist())

    predictions = np.asarray(all_predictions, dtype=np.int64)
    average_loss = total_loss / max(total_count, 1)

    present = np.unique(y[indices])
    macro_f1 = f1_score(
        y[indices], predictions,
        labels=present, average="macro", zero_division=0,
    )

    return average_loss, macro_f1, predictions


def choose_split(y, rows, cols, width, resolution):
    """Search split seeds so every class is present in val and test."""
    n_classes = len(CLASS_NAMES)

    best = None  # (score, seed, masks)

    for seed in range(SPLIT_SEED_START, SPLIT_SEED_START + SPLIT_SEED_TRIES):
        try:
            masks = block_split(
                rows, cols, width, resolution,
                patch=PATCH_SIZE, block_m=10000, seed=seed,
            )
        except ValueError:
            continue

        train_mask, val_mask, test_mask = masks

        # Training must contain every class.
        if any(np.sum(y[train_mask] == c) == 0 for c in range(n_classes)):
            continue

        score = min(
            int(np.sum(y[m] == c))
            for m in (val_mask, test_mask)
            for c in range(n_classes)
        )

        if best is None or score > best[0]:
            best = (score, seed, masks)

        if score >= MIN_SPLIT_PER_CLASS:
            break

    if best is None:
        raise RuntimeError("No valid geographical split found.")

    score, seed, masks = best

    if score < MIN_SPLIT_PER_CLASS:
        print(
            f"\nWARNING: no split gave >= {MIN_SPLIT_PER_CLASS} patches per "
            f"class in val and test. Best minimum was {score} (seed {seed})."
        )

    return seed, masks


def main():

    random.seed(SEED)
    np.random.seed(SEED)
    torch.manual_seed(SEED)

    torch.set_num_threads(max(1, min(4, torch.get_num_threads())))

    if not PATCH_FILE.exists():
        raise FileNotFoundError(
            f"Patch dataset not found: {PATCH_FILE}\n"
            "Run make_patches.py first."
        )

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    print("Loading CNN patch dataset...")

    with np.load(PATCH_FILE, allow_pickle=False) as data:

        required = {"X", "y", "rows", "cols", "W", "res_m", "bands", "patch"}
        missing = required.difference(data.files)

        if missing:
            raise ValueError(f"Patch dataset missing: {sorted(missing)}")

        X = data["X"]
        y = data["y"].astype(np.int64)
        rows = data["rows"]
        cols = data["cols"]

        width = int(data["W"])
        resolution = int(data["res_m"])
        patch_size = int(data["patch"])

        feature_names = [str(v) for v in data["bands"].tolist()]

    # --------------------------- VALIDATION ---------------------------

    if X.ndim != 4 or X.shape[1:] != (INPUT_CHANNELS, PATCH_SIZE, PATCH_SIZE):
        raise ValueError(f"Expected X shape (N, 6, 32, 32), got {X.shape}")

    if feature_names != FEATURE_NAMES:
        raise ValueError(
            f"Feature order mismatch.\n"
            f"Expected: {FEATURE_NAMES}\nFound: {feature_names}"
        )

    if patch_size != PATCH_SIZE:
        raise ValueError(f"Expected 32x32 patches, found {patch_size}")

    if not (len(X) == len(y) == len(rows) == len(cols)):
        raise ValueError("X, y, rows and cols have inconsistent lengths.")

    if len(X) == 0:
        raise ValueError("Patch dataset is empty.")

    if not np.isfinite(X).all():
        raise ValueError("Dataset contains NaN or infinite values.")

    if np.any((y < 0) | (y >= len(CLASS_NAMES))):
        raise ValueError("Invalid class IDs in patch dataset.")

    # --------------------------- DATASET INFO ---------------------------

    print("\nDATASET")
    print("------------------------------")
    print("Patch shape:", X.shape)
    print("Data type:", X.dtype)
    print("Features:", feature_names)
    print("Classes:", CLASS_NAMES)

    print("\nClass distribution:")
    for class_id, name in enumerate(CLASS_NAMES):
        print(f"{name:13s}: {int(np.sum(y == class_id)):,}")

    # --------------------------- GEOGRAPHICAL SPLIT ---------------------------

    print("\nCreating geographical train/validation/test split...")

    split_seed, (train_mask, val_mask, test_mask) = choose_split(
        y, rows, cols, width, resolution
    )

    train_indices = np.flatnonzero(train_mask)
    val_indices = np.flatnonzero(val_mask)
    test_indices = np.flatnonzero(test_mask)

    print("\nGEOGRAPHICAL SPLIT")
    print("------------------------------")
    print("Split seed:", split_seed)
    print("Training patches:", len(train_indices))
    print("Validation patches:", len(val_indices))
    print("Testing patches:", len(test_indices))

    if len(train_indices) == 0 or len(val_indices) == 0 or len(test_indices) == 0:
        raise ValueError("One or more geographical splits are empty.")

    if (np.any(train_mask & val_mask) or np.any(train_mask & test_mask)
            or np.any(val_mask & test_mask)):
        raise ValueError("Geographical split masks overlap.")

    print("\nClass distribution by split:")
    for class_id, name in enumerate(CLASS_NAMES):
        print(
            f"{name:13s} "
            f"train={int(np.sum(y[train_indices] == class_id)):5d} "
            f"val={int(np.sum(y[val_indices] == class_id)):5d} "
            f"test={int(np.sum(y[test_indices] == class_id)):5d}"
        )

    for split_name, indices in [
        ("training", train_indices),
        ("validation", val_indices),
        ("testing", test_indices),
    ]:
        missing_classes = [
            CLASS_NAMES[c] for c in range(len(CLASS_NAMES))
            if np.sum(y[indices] == c) == 0
        ]

        if missing_classes:
            if split_name in ("training", "validation"):
                raise ValueError(
                    f"Missing classes in {split_name} split: {missing_classes}."
                )
            print(
                f"\nWARNING: Missing classes in {split_name} split: "
                f"{missing_classes}. Metrics for these classes will not "
                "be evaluated."
            )

    # --------------------------- NORMALISATION ---------------------------

    print("\nCalculating training normalisation statistics...")
    mean, std = get_normalisation_stats(X, train_mask)

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print("Training device:", device)

    # --------------------------- MODEL ---------------------------

    model = SmallCNN(
        in_channels=INPUT_CHANNELS, n_classes=len(CLASS_NAMES)
    ).to(device)

    if USE_CLASS_WEIGHTS:
        counts = np.bincount(
            y[train_indices], minlength=len(CLASS_NAMES)
        ).astype(np.float64)
        weights = 1.0 / np.sqrt(np.maximum(counts, 1.0))
        weights = weights / weights.mean()
        print("Class weights:", {n: round(float(w), 3)
                                 for n, w in zip(CLASS_NAMES, weights)})
        weight_tensor = torch.tensor(weights, dtype=torch.float32, device=device)
        criterion = nn.CrossEntropyLoss(weight=weight_tensor)
        # Unweighted loss for validation reporting
        val_criterion = nn.CrossEntropyLoss()
    else:
        criterion = nn.CrossEntropyLoss()
        val_criterion = criterion

    optimizer = torch.optim.AdamW(
        model.parameters(), lr=LEARNING_RATE, weight_decay=WEIGHT_DECAY
    )

    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(
        optimizer, mode="max", factor=0.5, patience=2
    )

    best_val_f1 = -1.0
    best_state = None
    epochs_without_improvement = 0

    # --------------------------- TRAINING ---------------------------

    print("\nCNN TRAINING")
    print("------------------------------")

    for epoch in range(1, EPOCHS + 1):

        model.train()
        shuffled_indices = np.random.permutation(train_indices)

        total_train_loss = 0.0
        total_train_count = 0

        for start in range(0, len(shuffled_indices), BATCH_SIZE):
            batch_indices = shuffled_indices[start:start + BATCH_SIZE]

            # Sorted indices keep numpy fancy indexing efficient.
            batch_indices = np.sort(batch_indices)

            xb = make_batch(X, batch_indices, mean, std, device)
            xb = augment(xb)

            targets = torch.tensor(y[batch_indices], dtype=torch.long,
                                   device=device)

            optimizer.zero_grad()
            logits = model(xb)
            loss = criterion(logits, targets)
            loss.backward()
            optimizer.step()

            count = len(batch_indices)
            total_train_loss += loss.item() * count
            total_train_count += count

        train_loss = total_train_loss / max(total_train_count, 1)

        val_loss, val_f1, _ = evaluate(
            model, X, y, val_indices, mean, std, device, val_criterion
        )

        scheduler.step(val_f1)

        print(
            f"Epoch {epoch:02d}/{EPOCHS} | "
            f"Train loss: {train_loss:.4f} | "
            f"Val loss: {val_loss:.4f} | "
            f"Val macro F1: {val_f1:.4f}"
        )

        if val_f1 > best_val_f1:
            best_val_f1 = val_f1
            best_state = copy.deepcopy(model.state_dict())
            epochs_without_improvement = 0
        else:
            epochs_without_improvement += 1

        if epochs_without_improvement >= PATIENCE:
            print("Early stopping: validation score did not improve.")
            break

    if best_state is None:
        raise RuntimeError("CNN training did not produce a model.")

    model.load_state_dict(best_state)

    # --------------------------- FINAL TEST ---------------------------

    print("\nEvaluating on held-out geographical test blocks...")

    test_predictions = predict(model, X, test_indices, mean, std, device)
    y_test = y[test_indices]

    evaluated_classes = np.unique(y_test)

    test_accuracy = accuracy_score(y_test, test_predictions)

    test_macro_f1 = f1_score(
        y_test, test_predictions,
        labels=evaluated_classes, average="macro", zero_division=0,
    )

    report = classification_report(
        y_test, test_predictions,
        labels=evaluated_classes,
        target_names=[CLASS_NAMES[i] for i in evaluated_classes],
        zero_division=0,
    )

    matrix = confusion_matrix(
        y_test, test_predictions, labels=list(range(len(CLASS_NAMES)))
    )

    print("\nFINAL TEST RESULTS")
    print("------------------------------")
    print(f"Test accuracy: {test_accuracy:.4f}")
    print(f"Test macro F1: {test_macro_f1:.4f}")

    print("\nClasses evaluated:")
    for class_id in evaluated_classes:
        print("-", CLASS_NAMES[class_id])

    missing_test_classes = [
        CLASS_NAMES[i] for i in range(len(CLASS_NAMES))
        if i not in evaluated_classes
    ]

    if missing_test_classes:
        print("\nNot evaluated (no reference test samples):")
        for name in missing_test_classes:
            print("-", name)

    print("\nClassification report:")
    print(report)

    print("Confusion matrix (all classes):")
    print(matrix)

    # --------------------------- SAVE MODEL ---------------------------

    checkpoint = {
        "model_state_dict": model.state_dict(),
        "class_names": CLASS_NAMES,
        "feature_names": FEATURE_NAMES,
        "mean": mean.cpu(),
        "std": std.cpu(),
        "patch_size": PATCH_SIZE,
        "input_channels": INPUT_CHANNELS,
        "resolution_m": resolution,
        "split_seed": split_seed,
        "test_accuracy": float(test_accuracy),
        "test_macro_f1": float(test_macro_f1),
        "best_validation_macro_f1": float(best_val_f1),
    }

    torch.save(checkpoint, MODEL_FILE)

    metrics_file = OUTPUT_DIR / "cnn_metrics.txt"

    with open(metrics_file, "w", encoding="utf-8") as file:
        file.write("LULC CNN TEST RESULTS\n")
        file.write("=====================\n\n")
        file.write(f"Split seed: {split_seed}\n")
        file.write(f"Test accuracy: {test_accuracy:.4f}\n")
        file.write(f"Test macro F1: {test_macro_f1:.4f}\n")
        file.write(f"Best validation macro F1: {best_val_f1:.4f}\n\n")
        file.write("Classification report:\n")
        file.write(report)
        file.write("\nConfusion matrix:\n")
        file.write(np.array2string(matrix))

    print("\nMODEL SAVED")
    print("------------------------------")
    print("Model:", MODEL_FILE)
    print("Metrics:", metrics_file)


if __name__ == "__main__":
    main()