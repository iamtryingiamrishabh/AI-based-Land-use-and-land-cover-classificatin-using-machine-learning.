"""Run the LULC CNN over several geographical split seeds.

Reports per-seed results and mean +/- std, so you can see whether the
single-seed score (seed 42) is representative.

Usage (from D:\\major_project):
    python .\\scripts\\classification\\run_multi_seed.py
    python .\\scripts\\classification\\run_multi_seed.py 42 43 44 45 46 47 48
"""

import copy
import csv
import random
import sys

import numpy as np
import torch
import torch.nn as nn
from sklearn.metrics import (
    accuracy_score,
    confusion_matrix,
    f1_score,
    precision_recall_fscore_support,
)

from lulc_common import (
    OUTPUT_DIR,
    PATCH_FILE,
    CLASS_NAMES,
    FEATURE_NAMES,
    block_split,
)

# Reuse the model and helpers from train_cnn.py so both scripts stay in sync.
from train_cnn import (
    SmallCNN,
    augment,
    get_normalisation_stats,
    make_batch,
    predict,
    evaluate,
    EPOCHS,
    BATCH_SIZE,
    LEARNING_RATE,
    WEIGHT_DECAY,
    PATIENCE,
    PATCH_SIZE,
    INPUT_CHANNELS,
    USE_CLASS_WEIGHTS,
)

DEFAULT_SEEDS = [42, 43, 44, 45, 46]
N_CLASSES = len(CLASS_NAMES)


def load_data():
    with np.load(PATCH_FILE, allow_pickle=False) as data:
        X = data["X"]
        y = data["y"].astype(np.int64)
        rows = data["rows"]
        cols = data["cols"]
        width = int(data["W"])
        resolution = int(data["res_m"])
        feature_names = [str(v) for v in data["bands"].tolist()]

    if feature_names != FEATURE_NAMES:
        raise ValueError("Feature order mismatch in patch file.")
    if X.shape[1:] != (INPUT_CHANNELS, PATCH_SIZE, PATCH_SIZE):
        raise ValueError(f"Unexpected patch shape: {X.shape}")
    if not np.isfinite(X).all():
        raise ValueError("Dataset contains NaN or infinite values.")

    return X, y, rows, cols, width, resolution


def run_seed(seed, X, y, rows, cols, width, resolution, device):
    """Train and test one model for one split seed. Returns a dict or None."""

    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)

    train_mask, val_mask, test_mask = block_split(
        rows, cols, width, resolution,
        patch=PATCH_SIZE, block_m=10000, seed=seed,
    )

    train_idx = np.flatnonzero(train_mask)
    val_idx = np.flatnonzero(val_mask)
    test_idx = np.flatnonzero(test_mask)

    counts = {
        "train": np.bincount(y[train_idx], minlength=N_CLASSES),
        "val": np.bincount(y[val_idx], minlength=N_CLASSES),
        "test": np.bincount(y[test_idx], minlength=N_CLASSES),
    }

    print(f"\n=== Seed {seed} ===")
    for name, c in counts.items():
        print(f"{name:5s}: " + "  ".join(
            f"{CLASS_NAMES[i]}={c[i]}" for i in range(N_CLASSES)))

    if (counts["train"] == 0).any():
        print("SKIPPED: a class is missing from training.")
        return None
    if (counts["val"] == 0).any():
        print("SKIPPED: a class is missing from validation.")
        return None

    mean, std = get_normalisation_stats(X, train_mask)

    model = SmallCNN(INPUT_CHANNELS, N_CLASSES).to(device)

    if USE_CLASS_WEIGHTS:
        w = 1.0 / np.sqrt(np.maximum(counts["train"].astype(np.float64), 1.0))
        w = w / w.mean()
        criterion = nn.CrossEntropyLoss(
            weight=torch.tensor(w, dtype=torch.float32, device=device))
    else:
        criterion = nn.CrossEntropyLoss()
    val_criterion = nn.CrossEntropyLoss()

    optimizer = torch.optim.AdamW(
        model.parameters(), lr=LEARNING_RATE, weight_decay=WEIGHT_DECAY)
    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(
        optimizer, mode="max", factor=0.5, patience=2)

    best_f1, best_state, stale, best_epoch = -1.0, None, 0, 0

    for epoch in range(1, EPOCHS + 1):
        model.train()
        order = np.random.permutation(train_idx)

        for start in range(0, len(order), BATCH_SIZE):
            batch_idx = np.sort(order[start:start + BATCH_SIZE])
            xb = augment(make_batch(X, batch_idx, mean, std, device))
            tb = torch.tensor(y[batch_idx], dtype=torch.long, device=device)

            optimizer.zero_grad()
            loss = criterion(model(xb), tb)
            loss.backward()
            optimizer.step()

        _, val_f1, _ = evaluate(
            model, X, y, val_idx, mean, std, device, val_criterion)
        scheduler.step(val_f1)

        if val_f1 > best_f1:
            best_f1, best_epoch, stale = val_f1, epoch, 0
            best_state = copy.deepcopy(model.state_dict())
        else:
            stale += 1
            if stale >= PATIENCE:
                break

    model.load_state_dict(best_state)

    preds = predict(model, X, test_idx, mean, std, device)
    y_test = y[test_idx]

    present = np.unique(y_test)
    acc = accuracy_score(y_test, preds)
    macro = f1_score(y_test, preds, labels=present,
                     average="macro", zero_division=0)

    _, _, f1_per, support = precision_recall_fscore_support(
        y_test, preds, labels=list(range(N_CLASSES)), zero_division=0)
    f1_per = np.where(support > 0, f1_per, np.nan)

    cm = confusion_matrix(y_test, preds, labels=list(range(N_CLASSES)))

    print(f"best epoch {best_epoch} | val F1 {best_f1:.4f} | "
          f"test acc {acc:.4f} | test macro F1 {macro:.4f}")
    print("per-class F1:", {CLASS_NAMES[i]: (None if np.isnan(f1_per[i])
                                             else round(float(f1_per[i]), 3))
                            for i in range(N_CLASSES)})

    return {
        "seed": seed,
        "best_epoch": best_epoch,
        "val_f1": best_f1,
        "acc": acc,
        "macro_f1": macro,
        "f1_per": f1_per,
        "support": support,
        "cm": cm,
    }


def fmt(values):
    values = np.asarray(values, dtype=float)
    values = values[~np.isnan(values)]
    if len(values) == 0:
        return "n/a"
    return f"{values.mean():.4f} +/- {values.std(ddof=1) if len(values) > 1 else 0.0:.4f}"


def main():
    seeds = [int(s) for s in sys.argv[1:]] or DEFAULT_SEEDS

    if not PATCH_FILE.exists():
        raise FileNotFoundError(f"Run make_patches.py first: {PATCH_FILE}")

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    torch.set_num_threads(max(1, min(4, torch.get_num_threads())))
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

    print("Loading patches...")
    X, y, rows, cols, width, resolution = load_data()
    print("Patches:", X.shape, "| device:", device, "| seeds:", seeds)

    results = []
    for seed in seeds:
        try:
            r = run_seed(seed, X, y, rows, cols, width, resolution, device)
        except ValueError as e:
            print(f"\n=== Seed {seed} ===\nSKIPPED: {e}")
            r = None
        if r is not None:
            results.append(r)

    if not results:
        raise RuntimeError("No seed produced a usable split.")

    # ------------------------------------------------------------ summary
    lines = []
    lines.append("MULTI-SEED GEOGRAPHICAL SPLIT RESULTS")
    lines.append("=====================================")
    lines.append(f"Seeds used: {[r['seed'] for r in results]} "
                 f"({len(results)} of {len(seeds)})\n")

    header = f"{'seed':>5} {'epoch':>5} {'val F1':>7} {'acc':>7} {'macroF1':>8} "
    header += " ".join(f"{n[:8]:>9}" for n in CLASS_NAMES)
    lines.append(header)

    for r in results:
        row = f"{r['seed']:>5} {r['best_epoch']:>5} {r['val_f1']:>7.3f} "
        row += f"{r['acc']:>7.3f} {r['macro_f1']:>8.3f} "
        row += " ".join(
            f"{'n/a':>9}" if np.isnan(f) else f"{f:>9.3f}" for f in r["f1_per"])
        lines.append(row)

    lines.append("")
    lines.append(f"Test accuracy : {fmt([r['acc'] for r in results])}")
    lines.append(f"Test macro F1 : {fmt([r['macro_f1'] for r in results])}")
    for i, name in enumerate(CLASS_NAMES):
        vals = [r["f1_per"][i] for r in results]
        n_eval = int(np.sum(~np.isnan(vals)))
        lines.append(f"F1 {name:12s}: {fmt(vals)}  (evaluated in {n_eval} seeds)")

    total_cm = sum(r["cm"] for r in results)
    lines.append("\nSummed confusion matrix over seeds (rows = truth):")
    lines.append(np.array2string(total_cm))
    lines.append(
        "\nNote: the seeds re-split the SAME patches, so test sets overlap "
        "between seeds. The std understates uncertainty from new locations "
        "or dates.")

    text = "\n".join(lines)
    print("\n" + text)

    (OUTPUT_DIR / "cnn_multi_seed.txt").write_text(text, encoding="utf-8")

    with open(OUTPUT_DIR / "cnn_multi_seed.csv", "w",
              newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["seed", "best_epoch", "val_macro_f1", "test_acc",
                         "test_macro_f1"]
                        + [f"f1_{n}" for n in CLASS_NAMES]
                        + [f"support_{n}" for n in CLASS_NAMES])
        for r in results:
            writer.writerow(
                [r["seed"], r["best_epoch"], f"{r['val_f1']:.4f}",
                 f"{r['acc']:.4f}", f"{r['macro_f1']:.4f}"]
                + ["" if np.isnan(v) else f"{v:.4f}" for v in r["f1_per"]]
                + [int(v) for v in r["support"]])

    print("\nSaved:", OUTPUT_DIR / "cnn_multi_seed.txt")
    print("Saved:", OUTPUT_DIR / "cnn_multi_seed.csv")


if __name__ == "__main__":
    main()